# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Test / lint / type-check cache
.pytest_cache/
.pytest_cache_tmp/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# Build / packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Wikisource cache
data/cache_wikisource/

# Raw downloaded text can be regenerated
data/raw/*
!data/raw/.gitkeep

# Ciphertexts are supplied by the teacher or generated locally for testing
data/ciphertexts/*
!data/ciphertexts/.gitkeep

# Mock expected files are only for local development
data/mock_expected/

# Runtime outputs
outputs/*
!outputs/.gitkeep

# Temporary local files
data/processed/zadani_extracted.txt